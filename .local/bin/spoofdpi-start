#!/bin/bash

# 1. Enable the GNOME system proxy
gsettings set org.gnome.system.proxy mode 'manual'
gsettings set org.gnome.system.proxy.http host '127.0.0.1'
gsettings set org.gnome.system.proxy.http port 8080
gsettings set org.gnome.system.proxy.https host '127.0.0.1'
gsettings set org.gnome.system.proxy.https port 8080

echo "System Proxy ON. Starting SpoofDPI..."

# 2. Run SpoofDPI (It will use your ~/.config/spoofdpi/spoofdpi.toml settings)
spoofdpi --dns-mode https --dns-addr "1.1.1.1:53" --dns-https-url "https://cloudflare-dns.com/dns-query" --https-split-mode chunk --https-chunk-size 35

# 3. Disable the proxy immediately after SpoofDPI is closed
gsettings set org.gnome.system.proxy mode 'none'
echo ""
echo "SpoofDPI closed. System Proxy OFF."
